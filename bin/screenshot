#!/usr/bin/env bash
# screenshot [region|screen]: save to ~/Pictures/Screenshots and copy to the clipboard.
dir=$HOME/Pictures/Screenshots
file=$dir/$(date +%Y-%m-%d_%H-%M-%S).png
mkdir -p "$dir"

case ${1:-region} in
  region)
    area=$(slurp) || exit 0
    grim -g "$area" "$file" || exit 1
    ;;
  screen)
    grim "$file" || exit 1
    ;;
  *)
    echo "usage: screenshot [region|screen]" >&2
    exit 1
    ;;
esac

wl-copy < "$file"
notify-send "Screenshot" "Copied and saved to $file"
